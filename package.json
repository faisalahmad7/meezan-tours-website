{
  "name": "meezan-tours-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Meezan Tours & Travels - Hajj & Umrah tour operator, Pune. Prerendered multipage React site.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "admin": "vite --port 5173 --strictPort --open /admin",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.1.0",
    "@fontsource/amiri": "^5.1.0",
    "gsap": "^3.12.5",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.6.0",
    "vite": "^5.4.8"
  }
}
