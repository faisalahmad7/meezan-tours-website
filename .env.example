# Admin dashboard settings. Copy this file to .env.local ON AN AUTHORISED LAPTOP ONLY.
# .env.local is never committed. Never put these on Vercel or any website host. See docs/ADMIN.md.

# Login password for the admin.
ADMIN_PASSWORD=
# Long random string that signs the login cookie, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Lets "Save and publish" commit to GitHub, which updates the live website through Vercel.
# Fine-grained token for THIS repository only, permission "Contents: Read and write".
# Leave empty to only change the files on this computer.
GITHUB_TOKEN=
GITHUB_REPO=faisalahmad7/meezan-tours-website
GITHUB_BRANCH=main
