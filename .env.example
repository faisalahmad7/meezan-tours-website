# Admin dashboard (/admin). Server-side only: never prefix these with VITE_.
# Production: set them in Vercel > Project Settings > Environment Variables, then redeploy.
# Local development: copy this file to .env.local (git-ignored) and fill it in.

# Login password for /admin (choose a long one).
ADMIN_PASSWORD=
# Long random string that signs the login cookie, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Production only: lets the admin save content by committing to GitHub, which triggers a Vercel deploy.
# Create a fine-grained token at github.com/settings/tokens with access to THIS repository only and
# the permission "Contents: Read and write". Leave empty locally: the admin then edits src/content directly.
GITHUB_TOKEN=
GITHUB_REPO=faisalahmad7/meezan-tours-website
GITHUB_BRANCH=main
